{
  "name": "wasla-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wasla PWA / mobile web app (Wasla V1)",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "dev": "node --watch scripts/serve.mjs",
    "test": "node scripts/app-smoke.mjs",
    "build:www": "node scripts/build-www.mjs",
    "cap:add:android": "npm run build:www && npx cap add android",
    "cap:sync": "npm run build:www && npx cap sync android",
    "cap:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cap-build.ps1 -Flavor debug",
    "cap:build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cap-build.ps1 -Flavor release",
    "test:android": "node scripts/android-smoke.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2"
  }
}
