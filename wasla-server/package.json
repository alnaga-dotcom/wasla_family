{
  "name": "wasla-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wasla V1 backend prototype - registration, OTP, profile (Wasla_03/07/29)",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prod": "bash scripts/start.sh",
    "prod:win": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1",
    "backup": "bash scripts/backup.sh",
    "backup:win": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "deploy:check": "node scripts/deploy-check.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.1",
    "express-slow-down": "^3.1.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "twilio": "^6.0.2",
    "winston": "^3.19.0",
    "ws": "^8.21.2"
  }
}
