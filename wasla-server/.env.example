# Wasla server environment configuration
# Copy this file to .env and adjust for your environment

NODE_ENV=production
PORT=4000

# Public domain where the app will be served (used for CORS and links)
WASLA_PUBLIC_DOMAIN=https://wasla.family

# Allowed CORS origins in production (comma-separated)
# Include both the web app and the admin panel origins
WASLA_CORS_ORIGINS=https://wasla.family,https://admin.wasla.family

# Admin API key — change to a strong random secret in production
WASLA_ADMIN_KEY=change-me-to-a-long-random-secret

# OTP provider: twilio, email, or console (dev only — console is rejected in production)
WASLA_OTP_PROVIDER=email
WASLA_DEV_OTP=false

# Twilio credentials (for WASLA_OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP credentials (for WASLA_OTP_PROVIDER=email)
# Gmail example: enable 2-Step Verification, then create an "App password"
# (Google Account -> Security -> App passwords). Use that 16-char password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=<gmail-app-password>
SMTP_FROM=you@gmail.com
# Generic SMTP alternative (Mailgun, Zoho, etc.): use their host/port and SMTP_SECURE=false for 587/STARTTLS.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=<...>
#SMTP_PASS=<...>
#SMTP_FROM=Wasla <no-reply@wasla.family>

# Session and OTP TTL (ms)
WASLA_OTP_EXPIRY_MS=300000
WASLA_SESSION_TTL_MS=604800000

# Trust proxy when running behind a reverse proxy (nginx, etc.)
WASLA_TRUST_PROXY=true

# Directory for uploaded photos (must be writable)
WASLA_UPLOADS_DIR=./data/uploads

# Payment gateway: mock (instant, no real money) or 066city.
# Keep 'mock' to disable live payments until 066.city credentials are ready.
WASLA_PAYMENT_PROVIDER=mock

# 066.city gateway credentials (only needed when WASLA_PAYMENT_PROVIDER=066city)
WASLA_066_MERCHANT_ID=
WASLA_066_API_KEY=
WASLA_066_SECRET=
WASLA_066_BASE_URL=https://api.066.city

# Logging level: debug, info, warn, error
LOG_LEVEL=info
